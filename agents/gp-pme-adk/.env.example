# Configuração dos agentes GP-PME (Google ADK).
# Copie este arquivo para ".env" na mesma pasta e preencha os valores.
# Nenhuma credencial é obrigatória: sem elas, cada adapter roda em modo dry-run.

# --- Agentes (ADK) --------------------------------------------------------

# Modelo usado por todos os agentes. Padrão: gemini-2.5-flash.
GPPME_MODEL=gemini-2.5-flash

# Chave da API do Google AI Studio / Gemini, exigida pelo google-adk.
# Obtenha em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Plataforma de gestão ativa usada pelo orquestrador: clickup | notion | trello | jira | linear
GPPME_PLATAFORMA=trello

# Força modo dry-run (1 = ativo) mesmo com credenciais de plataforma configuradas.
# Útil para demonstrações sem tocar em dados reais. Se vazio/ausente, o dry-run
# é ativado automaticamente quando faltar alguma credencial da plataforma escolhida.
GPPME_DRY_RUN=

# --- ClickUp ---------------------------------------------------------------
# Gere em ClickUp > Configurações > Apps > API Token.
CLICKUP_TOKEN=

# --- Notion ------------------------------------------------------------------
# Crie uma integração em https://www.notion.so/my-integrations e compartilhe
# a página/base de dados alvo com ela.
NOTION_TOKEN=

# --- Trello --------------------------------------------------------------
# Obtenha em https://trello.com/power-ups/admin (API Key) e gere o Token
# autorizando o acesso da sua conta.
TRELLO_KEY=
TRELLO_TOKEN=

# --- Jira Cloud ------------------------------------------------------------
# URL do seu site Jira, sem barra no final. Ex.: https://suaempresa.atlassian.net
JIRA_URL=
# E-mail da conta Atlassian usada para gerar o token.
JIRA_EMAIL=
# Gere em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# --- Linear ------------------------------------------------------------------
# Gere em Linear > Settings > Security & access > Personal API keys.
LINEAR_API_KEY=
